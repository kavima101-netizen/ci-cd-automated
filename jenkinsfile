pipeline {
    agent any

    environment {
        IMAGE_NAME = 'html-login'
        CONTAINER_NAME = 'html-login'
        APP_SERVER = 'ec2-user@56.228.9.108'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/kavima101-netizen/ci-cd-automated.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t ${IMAGE_NAME}:latest .'
            }
        }

        stage('Save Docker Image') {
            steps {
                sh 'docker save ${IMAGE_NAME}:latest | gzip > html-login.tar.gz'
            }
        }

        stage('Copy Image to Application Server') {
            steps {
                sshagent(credentials: ['app-server-ssh']) {
                    sh '''
                    scp -o StrictHostKeyChecking=accept-new html-login.tar.gz ${APP_SERVER}:/tmp/
                    '''
                }
            }
        }

        stage('Deploy on Application Server') {
            steps {
                sshagent(credentials: ['app-server-ssh']) {
                    sh '''
                    ssh -o StrictHostKeyChecking=accept-new ${APP_SERVER} '
                    docker load -i /tmp/html-login.tar.gz &&
                    docker rm -f html-login 2>/dev/null || true
                    docker run -d --name html-login -p 80:80 --restart unless-stopped html-login:latest
                    '
                    '''
                }
            }
        }
    }
}